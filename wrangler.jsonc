{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nucleovip",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
